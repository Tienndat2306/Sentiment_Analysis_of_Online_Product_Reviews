# E-Commerce Sentiment Intelligence - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.

# Google Gemini API Key (Required for semantic verification & teacher labeling)
GEMINI_API_KEY=your_gemini_api_key_here

# Lazada Session Cookie (Optional: For crawling review data on Lazada)
LAZADA_COOKIE=your_lazada_cookie_here

# MongoDB Connection (Optional: Governed Semantic Layer & Trend Sync)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ecommerce_sentiment

# Big Data & Distributed Execution (Optional: Defaults to local[*])
SPARK_MASTER=local[*]
HDFS_NAMENODE_URI=hdfs://localhost:9000
